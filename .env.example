# Server
PORT=3000
NODE_ENV=development

# Required in production. Use 32+ random characters.
JWT_SECRET=

# Admin account, created automatically on first start. Change the password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Tournament Admin

# Brevo email (recommended). Can also be entered in the admin Settings tab.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=ML Tournament

# Optional Gmail SMTP fallback
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Emails certificates automatically when the final match is scored
AUTO_CERTIFICATES=true

# Postgres connection string (Neon, Render Postgres, etc.).
# When set, the app uses Postgres instead of SQLite and creates its tables on first start.
# Neon pooled connection strings already end with ?sslmode=require.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# SQLite file path (only used when DATABASE_URL is empty).
# Point this at a persistent disk in production.
# DB_PATH=/data/database.sqlite
